# 이 파일을 프로젝트 루트의 .env로 복사하고 실제 값을 입력하세요.
# 실제 비밀번호를 이 예시 파일에 저장하지 마세요.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=moeum

# 이메일 인증번호 발송 (Gmail HTTPS API, SMTP/도메인 구매 불필요)
# Render 백엔드 Environment에도 아래 네 값을 등록하세요.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# OAuth로 발송 권한을 허용한 본인의 Gmail 주소
GMAIL_FROM_EMAIL=

# GitHub OAuth App (Client Secret은 실제 .env에만 입력하세요.)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
# 로컬 테스트에서만 이메일 중복 시 임시 이메일 사용 (기본 비활성, 배포 시 비워두세요.)
GITHUB_TEST_EMAIL=

# Required for GitHub login; deploy the React login_code exchange callback first.
FRONTEND_AUTH_CALLBACK_URL=http://127.0.0.1:5173/auth/github/callback
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
