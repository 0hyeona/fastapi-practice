# 이 파일을 프로젝트 루트의 .env로 복사하고 실제 값을 입력하세요.
# 실제 비밀번호를 이 예시 파일에 저장하지 마세요.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=moeum

# 이메일 인증번호 발송 (STARTTLS: 587 / SSL: 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
# Gmail: 일반 계정 비밀번호가 아닌 16자 앱 비밀번호
SMTP_PASSWORD=
# 인증번호를 보내는 발신 주소 (보통 SMTP_USER와 동일)
SMTP_FROM=
