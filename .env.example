# 이 파일을 프로젝트 루트의 .env로 복사하고 실제 값을 입력하세요.
# 실제 비밀번호를 이 예시 파일에 저장하지 마세요.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=moeum

# 이메일 인증번호 발송 (Gmail HTTPS API, SMTP/도메인 구매 불필요)
# Render 백엔드 Environment에도 아래 네 값을 등록하세요.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# OAuth로 발송 권한을 허용한 본인의 Gmail 주소
GMAIL_FROM_EMAIL=

# GitHub OAuth App (Client Secret은 실제 .env에만 입력하세요.)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
# 로컬 테스트에서만 이메일 중복 시 임시 이메일 사용 (기본 비활성, 배포 시 비워두세요.)
GITHUB_TEST_EMAIL=

# Required for GitHub login; deploy the React login_code exchange callback first.
FRONTEND_AUTH_CALLBACK_URL=http://127.0.0.1:5173/auth/github/callback
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Repository read token, restricted to one local users.id and listed owner/repo values.
GITHUB_TOKEN=
GITHUB_TOKEN_OWNER_ID=
GITHUB_ALLOWED_REPOSITORIES=
# Figma/Notion server credentials, scoped to a local users.id and explicit resources.
FIGMA_TOKEN=
FIGMA_TOKEN_OWNER_ID=
FIGMA_ALLOWED_FILE_KEYS=
NOTION_TOKEN=
# 프로젝트 소유자의 MOEUM users.id (숫자). Notion 계정 ID/프로젝트 ID 아님.
NOTION_TOKEN_OWNER_ID=
# 허용할 페이지 ID 또는 Notion 페이지 URL. 여러 개면 쉼표로 구분.
NOTION_ALLOWED_PAGE_IDS=

# 사용자별 Notion OAuth 연결 (Any workspace)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Notion에 등록한 프론트 콜백 URL과 동일하게 설정
NOTION_OAUTH_REDIRECT_URI=http://localhost:5173/auth/notion/callback
# Fernet.generate_key()로 생성. 배포 간 같은 값을 유지하고 Git에 저장 금지.
NOTION_CREDENTIAL_ENCRYPTION_KEY=

# S5 Story AI 분석 (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-4.1-mini
